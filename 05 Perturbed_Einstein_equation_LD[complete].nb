Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     SuperscriptBox["\[CapitalGamma]", "a"], "bc"], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{
      SuperscriptBox["g", "ad"], "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "b"], " ", 
        SubscriptBox["g", "dc"]}], "+", 
       RowBox[{
        SubscriptBox["\[PartialD]", "c"], " ", 
        SubscriptBox["g", "db"]}], "-", 
       RowBox[{
        SubscriptBox["\[PartialD]", "d"], " ", 
        SubscriptBox["g", "bc"]}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"147f603f-51f1-614e-be8e-516b4e6e0e86"],
