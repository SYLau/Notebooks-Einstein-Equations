Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalGamma]", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"gUpUp", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "s"}], "]"}], "]"}], "\[IndentingNewLine]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SubscriptBox["\[PartialD]", 
             RowBox[{"x", "[", 
              RowBox[{"[", "k", "]"}], "]"}]], 
            RowBox[{"g", "[", 
             RowBox[{"[", 
              RowBox[{"s", ",", "j"}], "]"}], "]"}]}], "+", 
           RowBox[{
            SubscriptBox["\[PartialD]", 
             RowBox[{"x", "[", 
              RowBox[{"[", "j", "]"}], "]"}]], 
            RowBox[{"g", "[", 
             RowBox[{"[", 
              RowBox[{"s", ",", "k"}], "]"}], "]"}]}], "-", 
           RowBox[{
            SubscriptBox["\[PartialD]", 
             RowBox[{"x", "[", 
              RowBox[{"[", "s", "]"}], "]"}]], 
            RowBox[{"g", "[", 
             RowBox[{"[", 
              RowBox[{"j", ",", "k"}], "]"}], "]"}]}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], " ", 
  ";"}]], "Input",
 CellChangeTimes->{
