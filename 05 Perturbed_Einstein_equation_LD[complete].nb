 CellLabel->"In[5]:=",ExpressionUUID->"efdd9d4c-7bb9-c048-abbd-0b5c14ff163d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SubLaplace", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       SubscriptBox["Y", "lm"], 
       TagBox[
        RowBox[{"(", 
         RowBox[{"2", ",", "0"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}], "->", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "\[ScriptL]"}], 
       RowBox[{"(", 
        RowBox[{"\[ScriptL]", "+", "1"}], ")"}], " ", 
       RowBox[{
        SubscriptBox["Y", "lm"], "[", 
        RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}]}], "-", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"], " ", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["Y", "lm"], 
         TagBox[
          RowBox[{"(", 
           RowBox[{"0", ",", "2"}], ")"}],
          Derivative],
         MultilineFunction->None], "[", 
        RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}]}], "-", 
      RowBox[{
       RowBox[{"Cot", "[", "\[Theta]", "]"}], " ", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["Y", "lm"], 
         TagBox[
          RowBox[{"(", 
           RowBox[{"1", ",", "0"}], ")"}],
          Derivative],
         MultilineFunction->None], "[", 
        RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}]}]}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9628449047800865`*^9, 3.962845008180647*^9}, {
  3.9628450564665337`*^9, 3.962845062179819*^9}, {3.962845095830118*^9, 
  3.962845101615963*^9}, {3.962845157746502*^9, 3.962845157996668*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"6dc3c18d-fb14-494f-8293-d846611be48b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SubTOV", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Lambda]", "[", "r", "]"}], "->", 
      RowBox[{"-", 
       RowBox[{"Log", "[", 
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{"2", 
           RowBox[{"m", "[", "r", "]"}]}], "r"]}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[Lambda]", "\[Prime]"], "[", "r", "]"}], "->", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", 
         RowBox[{"m", "[", "r", "]"}]}], "+", 
        RowBox[{"8", " ", "\[Pi]", " ", 
         SuperscriptBox["r", "3"], " ", 
         RowBox[{"\[Rho]0", "[", "r", "]"}]}]}], 
       RowBox[{"r", " ", 
        RowBox[{"(", 
         RowBox[{"r", "-", 
          RowBox[{"2", " ", 
           RowBox[{"m", "[", "r", "]"}]}]}], ")"}]}]]}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[Nu]", "\[Prime]"], "[", "r", "]"}], "->", 
      FractionBox[
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"m", "[", "r", "]"}]}], "+", 
        RowBox[{"8", " ", "\[Pi]", " ", 
         SuperscriptBox["r", "3"], " ", 
         RowBox[{"p0", "[", "r", "]"}]}]}], 
       RowBox[{"r", " ", 
        RowBox[{"(", 
         RowBox[{"r", "-", 
          RowBox[{"2", " ", 
           RowBox[{"m", "[", "r", "]"}]}]}], ")"}]}]]}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.963178854033306*^9, 3.9631788676477757`*^9}, {
   3.963179124380272*^9, 3.963179136730755*^9}, 3.963183672731308*^9, 
