        RowBox[{"x", "[", 
         RowBox[{"[", "l", "]"}], "]"}]], 
       RowBox[{"\[CapitalGamma]", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}]}], 
      "\[IndentingNewLine]", "\t", "+", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
