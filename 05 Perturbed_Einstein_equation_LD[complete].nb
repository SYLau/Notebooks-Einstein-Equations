          RowBox[{"X", "[", "r", "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Rho]0", "[", "r", "]"}], "+", 
            RowBox[{"p0", "[", "r", "]"}]}], ")"}], 
          SuperscriptBox["E", 
           RowBox[{
            RowBox[{"\[Nu]", "[", "r", "]"}], "/", "2"}]], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             FractionBox["1", "2"], 
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["r", 
                RowBox[{"-", "1"}]], "-", 
               RowBox[{
                FractionBox["1", "2"], 
                RowBox[{
                 RowBox[{"\[Nu]", "'"}], "[", "r", "]"}]}]}], ")"}], 
             RowBox[{"H0", "[", "r", "]"}]}], "+", 
            RowBox[{
             FractionBox["1", "2"], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"r", " ", 
                SuperscriptBox["\[Omega]", "2"], " ", 
                SuperscriptBox["E", 
                 RowBox[{"-", 
                  RowBox[{"\[Nu]", "[", "r", "]"}]}]]}], "+", 
               RowBox[{
                FractionBox["1", "2"], "\[ScriptL]", 
                RowBox[{"(", 
                 RowBox[{"\[ScriptL]", "+", "1"}], ")"}], 
                SuperscriptBox["r", 
                 RowBox[{"-", "1"}]]}]}], ")"}], 
             RowBox[{"H1", "[", "r", "]"}]}], "+", 
            RowBox[{
             FractionBox["1", "2"], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                FractionBox["3", "2"], 
                RowBox[{
                 RowBox[{"\[Nu]", "'"}], "[", "r", "]"}]}], "-", 
               SuperscriptBox["r", 
                RowBox[{"-", "1"}]]}], ")"}], 
             RowBox[{"\[ScriptCapitalK]", "[", "r", "]"}]}], "-", 
            RowBox[{
             FractionBox["1", "2"], "\[ScriptL]", 
             RowBox[{"(", 
              RowBox[{"\[ScriptL]", "+", "1"}], ")"}], 
             RowBox[{
              RowBox[{"\[Nu]", "'"}], "[", "r", "]"}], 
             SuperscriptBox["r", 
              RowBox[{"-", "2"}]], " ", 
             RowBox[{"V", "[", "r", "]"}]}], "-", 
            RowBox[{
             SuperscriptBox["r", 
              RowBox[{"-", "1"}]], 
             RowBox[{"(", 
