Cell["\<\
May use SubDisplay to suppress the function dependence on [r],[\[Theta], \
\[Phi]]. For clarity in display.
To use, add the rule after the expression to be displayed:
\tExpression /. SubDisplay\
\>", "Text",
 CellChangeTimes->{{3.9628149706156483`*^9, 3.9628150496998215`*^9}, {
   3.962838529439623*^9, 3.962838529606146*^9}, 3.963309464892292*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"a03f9715-a5ed-da4d-8e3a-bd07d499fe72"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SubDisplay", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"f_", "[", "r", "]"}], ":>", " ", "f"}], ",", 
     RowBox[{
      RowBox[{"f_", "[", 
       RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}], ":>", " ", "f"}]}], 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9628116730196743`*^9, 3.962811725286764*^9}, {
   3.962811846835924*^9, 3.962811850087101*^9}, 3.9628133904593353`*^9, {
