Cell[BoxData[{
 RowBox[{
  RowBox[{"LD\[Ellipsis]Eq11", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"X", "'"}], "[", "r", "]"}], "-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[ScriptL]"}], " ", 
