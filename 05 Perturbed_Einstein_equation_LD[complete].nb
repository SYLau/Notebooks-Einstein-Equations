Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     SuperscriptBox["R", "a"], "bcd"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "c"], " ", 
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", "a"], "bd"]}], "-", 
     RowBox[{
      SubscriptBox["\[PartialD]", "d"], " ", 
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", "a"], "bc"]}], "+", 
     RowBox[{
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", "e"], "bd"], 
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", "a"], "ec"]}], "-", 
