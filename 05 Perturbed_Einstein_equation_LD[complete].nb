Cell[BoxData[
 RowBox[{
  RowBox[{"dT", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[PartialD]", 
          RowBox[{"x", "[", 
           RowBox[{"[", "s1", "]"}], "]"}]], 
         RowBox[{"T", "[", 
          RowBox[{"[", 
           RowBox[{"s1", ",", "i"}], "]"}], "]"}]}], "+", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[CapitalGamma]", "[", 
             RowBox[{"[", 
              RowBox[{"s1", ",", "s1", ",", "s2"}], "]"}], "]"}], " ", 
            RowBox[{"T", "[", 
             RowBox[{"[", 
              RowBox[{"s2", ",", "i"}], "]"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"\[CapitalGamma]", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "s1", ",", "s2"}], "]"}], "]"}], " ", 
            RowBox[{"T", "[", 
             RowBox[{"[", 
              RowBox[{"s1", ",", "s2"}], "]"}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"s2", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"s1", ",", "1", ",", "n"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.962820091300476*^9, 3.9628201100892334`*^9}, {
   3.96282025066646*^9, 3.962820310571884*^9}, {3.962820382910368*^9, 
   3.962820469340353*^9}, 3.98434012470504*^9, 3.984348721204918*^9},
 CellLabel->"In[46]:=",ExpressionUUID->"a0d7bd06-6a0c-e149-94e3-bbfbf60769ac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]dT", "=", 
   RowBox[{"Coefficient", "[", 
    RowBox[{
     RowBox[{"Series", "[", 
      RowBox[{"dT", ",", 
       RowBox[{"{", 
        RowBox[{"\[Epsilon]", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
     "\[Epsilon]", ",", "1"}], "]"}]}], ";"}]], "Input",
