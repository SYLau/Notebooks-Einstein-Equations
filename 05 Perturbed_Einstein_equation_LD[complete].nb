Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     SuperscriptBox["\[CapitalGamma]", "a"], "bc"], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{
      SuperscriptBox["g", 
       RowBox[{"a", " ", "d"}]], "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "b"], " ", 
        SubscriptBox["g", "dc"]}], "+", 
       RowBox[{
        SubscriptBox["\[PartialD]", "c"], " ", 
        SubscriptBox["g", "db"]}], "-", 
       RowBox[{
