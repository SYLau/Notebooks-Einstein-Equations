                  RowBox[{"\[Rho]0", "[", "r", "]"}], "+", 
                  RowBox[{"p0", "[", "r", "]"}]}], ")"}], 
                SuperscriptBox["E", 
                 RowBox[{
                  RowBox[{"\[Lambda]", "[", "r", "]"}], "/", "2"}]]}], "+", 
               RowBox[{
                SuperscriptBox["\[Omega]", "2"], 
                SuperscriptBox["E", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"\[Lambda]", "[", "r", "]"}], "/", "2"}], "-", 
                  RowBox[{"\[Nu]", "[", "r", "]"}]}]]}], "-", 
               RowBox[{
                FractionBox["1", "2"], 
                SuperscriptBox["r", "2"], 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{
                   SuperscriptBox["r", 
                    RowBox[{"-", "2"}]], " ", 
                   SuperscriptBox["E", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"\[Lambda]", "[", "r", "]"}]}], "/", "2"}]], 
                   RowBox[{
                    RowBox[{"\[Nu]", "'"}], "[", "r", "]"}]}], ",", "r"}], 
                 "]"}]}]}], ")"}], 
             RowBox[{"W", "[", "r", "]"}]}]}], ")"}]}]}], ")"}]}], "/.", 
      RowBox[{"\[GothicS]\[GothicO]\[GothicL]X", "[", "r", "]"}]}], "/.", 
     RowBox[{"\[GothicS]\[GothicO]\[GothicL]dp0", "[", "r", "]"}]}], "/.", 
    "SubTOV"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"FullSimplify", "[", 
