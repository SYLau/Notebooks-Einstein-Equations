  0.94, 0.91, 0.88],ExpressionUUID->"01322143-d61c-1a4d-8c7e-0d1e271efc79"],

Cell[TextData[{
 "Unit normal vector: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[ScriptN]", "a"], "=", 
    RowBox[{
     SuperscriptBox["\[ScriptCapitalN]", "a"], "/", 
     SqrtBox[
      RowBox[{
       SubscriptBox["\[ScriptCapitalN]", "b"], 
       SuperscriptBox["\[ScriptCapitalN]", "b"]}]]}]}], TraditionalForm]],
  ExpressionUUID->"42eab6d8-fcd8-f241-a4c6-db44c99224e4"],
