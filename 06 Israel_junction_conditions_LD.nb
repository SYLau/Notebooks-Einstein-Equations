Cell[TextData[{
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Delta]u", "a"], "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], 
      SuperscriptBox["u", "a"], 
      SuperscriptBox["u", "b"], 
      SuperscriptBox["u", "c"], 
      SubscriptBox["\[Delta]g", 
       RowBox[{"b", " ", "c"}]]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[Delta]", 
         RowBox[{"  ", "b"}], "a"], "+", 
        RowBox[{
         SuperscriptBox["u", "a"], 
         SubscriptBox["u", "b"]}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["u", "c"], " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", "c"], 
          SuperscriptBox["\[Xi]", "b"]}]}], "-", 
        RowBox[{
         SuperscriptBox["\[Xi]", "c"], " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", "c"], 
          SuperscriptBox["u", "b"]}]}]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"1c6ec04d-4e6c-9240-b9ec-51740971c883"],
 "."
}], "Text",
