63e27e606cb0"],

Cell[TextData[{
 "Surface defined by the scalar function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     StyleBox["x",
      FontWeight->"Bold"], ")"}], " ", "=", " ", "constant"}], 
   TraditionalForm]],ExpressionUUID->"34227ce8-8f41-8146-857f-5713c2d8531c"],
 ","
}], "Text",
 CellChangeTimes->{{3.9628132451615753`*^9, 3.9628132505441017`*^9}, {
  3.9843997055432854`*^9, 3.984399707931595*^9}, {3.9844119955713444`*^9, 
  3.984412068689184*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"bcc374ee-2579-534b-b332-438e185f47da"],

Cell[TextData[{
 " Perturbed surface: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"r", "\[TildeEqual]", 
      RowBox[{
       SubscriptBox["R", "i"], "+", 
       SuperscriptBox["\[Xi]", "r"], "+", 
       RowBox[{"\[ScriptCapitalO]", "(", 
        SuperscriptBox["\[Xi]", "2"], ")"}]}]}], " ", "\[Implies]", " ", 
     RowBox[{"f", "(", 
      StyleBox["x",
       FontWeight->"Bold"], ")"}]}], " ", "=", 
    RowBox[{
     RowBox[{"r", "-", 
      SuperscriptBox["\[Xi]", "r"]}], "=", "constant"}]}], TraditionalForm]],
  ExpressionUUID->"3669af59-bf09-cb45-b88e-30f0dc3cd2ef"],
 ","
}], "Text",
 CellChangeTimes->{{3.9628132451615753`*^9, 3.9628132505441017`*^9}, {
  3.9843997055432854`*^9, 3.984399707931595*^9}, {3.9844119955713444`*^9, 
  3.984412068689184*^9}, {3.9845221283542614`*^9, 3.9845222498239517`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"a3cb1a89-3f84-3c48-9645-cd71040e78f3"],

Cell[TextData[{
 "Normal one-form: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalN]", "a"], "=", 
    RowBox[{
     SubscriptBox["\[Del]", "a"], "f"}]}], TraditionalForm]],ExpressionUUID->
  "85c9fec3-f20f-2844-9774-81cea9d3fb05"],
 ","
}], "Text",
